<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.res.mapper.ResArticlesMapper">

    <resultMap type="ResArticles" id="ResArticlesResult">
        <result property="articleId"    column="article_id"    />
        <result property="orderNum"    column="order_num"    />
        <result property="title"    column="title"    />
        <result property="categoryId"    column="category_id"    />
        <result property="typeId"    column="type_id"    />
        <result property="content"    column="content"    />
        <result property="views"    column="views"    />
        <result property="status"    column="status"    />
        <result property="appored"    column="appored"    />
        <result property="pic"    column="pic"    />
        <result property="userId"    column="user_id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="apporBy"    column="appor_by"    />
        <result property="apporTime"    column="appor_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectResArticlesVo">
        select article_id, order_num, title, category_id, type_id, content, views, status, appored, pic, user_id, dept_id, create_by, create_time, update_by, update_time, appor_by, appor_time, remark from res_articles
    </sql>

    <select id="selectResArticlesList" parameterType="ResArticles" resultMap="ResArticlesResult">
        <include refid="selectResArticlesVo"/>
        <where>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="typeId != null "> and type_id = #{typeId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="appored != null  and appored != ''"> and appored = #{appored}</if>
        </where>
    </select>

    <select id="selectResArticlesByArticleId" parameterType="Long" resultMap="ResArticlesResult">
        <include refid="selectResArticlesVo"/>
        where article_id = #{articleId}
    </select>

    <insert id="insertResArticles" parameterType="ResArticles" useGeneratedKeys="true" keyProperty="articleId">
        insert into res_articles
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">order_num,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="typeId != null">type_id,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="views != null">views,</if>
            <if test="status != null">status,</if>
            <if test="appored != null">appored,</if>
            <if test="pic != null">pic,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="apporBy != null">appor_by,</if>
            <if test="apporTime != null">appor_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">#{orderNum},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="typeId != null">#{typeId},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="views != null">#{views},</if>
            <if test="status != null">#{status},</if>
            <if test="appored != null">#{appored},</if>
            <if test="pic != null">#{pic},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="apporBy != null">#{apporBy},</if>
            <if test="apporTime != null">#{apporTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateResArticles" parameterType="ResArticles">
        update res_articles
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="typeId != null">type_id = #{typeId},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="views != null">views = #{views},</if>
            <if test="status != null">status = #{status},</if>
            <if test="appored != null">appored = #{appored},</if>
            <if test="pic != null">pic = #{pic},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where article_id = #{articleId}
    </update>

    <delete id="deleteResArticlesByArticleId" parameterType="Long">
        delete from res_articles where article_id = #{articleId}
    </delete>

    <delete id="deleteResArticlesByArticleIds" parameterType="String">
        delete from res_articles where article_id in
        <foreach item="articleId" collection="array" open="(" separator="," close=")">
            #{articleId}
        </foreach>
    </delete>
</mapper>