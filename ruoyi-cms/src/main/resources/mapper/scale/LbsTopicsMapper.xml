<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.scale.mapper.LbsTopicsMapper">
    
    <resultMap type="LbsTopicsVo" id="LbsTopicsResult">
        <result property="topicId"    column="topic_id"    />
        <result property="contextId"    column="context_id"    />
        <result property="contextName"    column="context_name"    />
        <result property="orderNum"    column="order_num"    />
        <result property="title"    column="title"    />
        <result property="topicType"    column="topic_type"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap id="LbsTopicsLbsOptionsResult" type="LbsTopics" extends="LbsTopicsResult">
        <collection property="lbsOptionsList" ofType="LbsOptions" column="topic_id" select="selectLbsOptionsList" />
    </resultMap>

    <resultMap type="LbsOptions" id="LbsOptionsResult">
        <result property="optionId"    column="option_id"    />
        <result property="topicId"    column="topic_id"    />
        <result property="orderNum"    column="order_num"    />
        <result property="title"    column="title"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectLbsTopicsVo">
        select t.topic_id,t.context_id,c.context_name, t.order_num, t.title, t.topic_type, t.status, t.create_by, t.create_time, t.update_by, t.update_time, t.remark from lbs_topics t
        left join lbs_contexts c on t.context_id=c.context_id
    </sql>

    <select id="selectLbsTopicsList" parameterType="LbsTopics" resultMap="LbsTopicsResult">
        <include refid="selectLbsTopicsVo"/>
        <where>
            <if test="contextId != null  and contextId != ''"> and t.context_id = #{contextId}</if>
            <if test="contextName != null  and contextName != ''"> and c.context_name like concat('%', #{contextName}, '%')</if>
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="topicType != null  and topicType != ''"> and topic_type = #{topicType}</if>
            <if test="status != null  and status != ''"> and t.status = #{status}</if>
        </where>
    </select>
    
    <select id="selectLbsTopicsByTopicId" parameterType="Long" resultMap="LbsTopicsLbsOptionsResult">
        select topic_id,context_id, order_num, title, topic_type, status, create_by, create_time, update_by, update_time, remark
        from lbs_topics
        where topic_id = #{topicId}
    </select>

    <select id="selectLbsOptionsList" resultMap="LbsOptionsResult">
        select option_id, topic_id, order_num, title, status, create_by, create_time, update_by, update_time, remark
        from lbs_options
        where topic_id = #{topic_id}
    </select>

    <insert id="insertLbsTopics" parameterType="LbsTopics" useGeneratedKeys="true" keyProperty="topicId">
        insert into lbs_topics
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="contextId != null">context_id,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="title != null">title,</if>
            <if test="topicType != null">topic_type,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="contextId != null">#{contextId},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="title != null">#{title},</if>
            <if test="topicType != null">#{topicType},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateLbsTopics" parameterType="LbsTopics">
        update lbs_topics
        <trim prefix="SET" suffixOverrides=",">
            <if test="contextId != null">context_id = #{contextId},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="title != null">title = #{title},</if>
            <if test="topicType != null">topic_type = #{topicType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where topic_id = #{topicId}
    </update>

    <delete id="deleteLbsTopicsByTopicId" parameterType="Long">
        delete from lbs_topics where topic_id = #{topicId}
    </delete>

    <delete id="deleteLbsTopicsByTopicIds" parameterType="String">
        delete from lbs_topics where topic_id in 
        <foreach item="topicId" collection="array" open="(" separator="," close=")">
            #{topicId}
        </foreach>
    </delete>
    
    <delete id="deleteLbsOptionsByTopicIds" parameterType="String">
        delete from lbs_options where topic_id in 
        <foreach item="topicId" collection="array" open="(" separator="," close=")">
            #{topicId}
        </foreach>
    </delete>

    <delete id="deleteLbsOptionsByTopicId" parameterType="Long">
        delete from lbs_options where topic_id = #{topicId}
    </delete>

    <insert id="batchLbsOptions">
        insert into lbs_options( option_id, topic_id, order_num, title, status, create_by, create_time, update_by, update_time, remark) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.optionId}, #{item.topicId}, #{item.orderNum}, #{item.title}, #{item.status}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark})
        </foreach>
    </insert>
</mapper>