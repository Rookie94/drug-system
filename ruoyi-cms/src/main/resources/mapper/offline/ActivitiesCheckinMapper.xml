<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.offline.mapper.ActivitiesCheckinMapper">
    
    <resultMap type="ActivitiesCheckinVo" id="ActivitiesCheckinResult">
        <result property="checkinId"    column="checkin_id"    />
        <result property="activityId"    column="activity_id"    />
        <result property="activityName"    column="activity_name"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="checkinTime"    column="checkin_time"    />
        <result property="userId"    column="user_id"    />
        <result property="userType"    column="user_type"    />
        <result property="userName"    column="user_name"    />
        <result property="nickName"    column="nick_name"    />
        <result property="phonenumber"    column="phonenumber"    />
        <result property="deptId"    column="dept_id"    />
        <result property="deptName"    column="dept_name"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectActivitiesCheckinVo">
        select t.checkin_id,t.activity_id,b.activity_name,b.start_time,b.end_time,t.checkin_time,t.user_id,c.user_type,
               c.user_name,c.nick_name,c.phonenumber,t.dept_id,d.dept_name,t.create_by,t.create_time,t.update_by,
               t.update_time,t.remark from ofa_activities_checkin t
                   left join ofa_activities b on t.activity_id=b.activity_id
                   left join sys_user c on t.user_id=c.user_id left join sys_dept d  on t.dept_id=d.dept_id
    </sql>

    <select id="selectActivitiesCheckinList" parameterType="ActivitiesCheckin" resultMap="ActivitiesCheckinResult">
        <include refid="selectActivitiesCheckinVo"/>
        <where>  
            <if test="checkinId != null "> and t.checkin_id = #{checkinId}</if>
            <if test="activityId != null "> and t.activity_id = #{activityId}</if>
            <if test="activityName != null  and activityName != ''"> and activity_name like concat('%', #{activityName}, '%')</if>
            <if test="startTime != null "> and start_time &gt;= #{startTime}</if>
            <if test="endTime != null "> and end_time &lt;= #{endTime}</if>
            <if test="params.beginCheckinTime != null and params.beginCheckinTime != '' and params.endCheckinTime != null and params.endCheckinTime != ''"> and checkin_time between #{params.beginCheckinTime} and #{params.endCheckinTime}</if>
            <if test="userId != null "> and t.user_id = #{userId}</if>
            <if test="userType != null  and userType != ''"> and user_type = #{userType}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="nickName != null  and nickName != ''"> and nick_name like concat('%', #{nickName}, '%')</if>
            <if test="phonenumber != null  and phonenumber != ''"> and phonenumber = #{phonenumber}</if>
            <if test="deptId != null "> and t.dept_id = #{deptId}</if>
            <if test="deptName != null  and deptName != ''"> and dept_name like concat('%', #{deptName}, '%')</if>
        </where>
    </select>
    
    <select id="selectActivitiesCheckinByCheckinId" parameterType="Long" resultMap="ActivitiesCheckinResult">
        <include refid="selectActivitiesCheckinVo"/>
        where checkin_id = #{checkinId}
    </select>

    <insert id="insertActivitiesCheckin" parameterType="ActivitiesCheckin">
        insert into ofa_activities_checkin
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="checkinId != null">checkin_id,</if>
            <if test="activityId != null">activity_id,</if>
            <if test="checkinTime != null">checkin_time,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="checkinId != null">#{checkinId},</if>
            <if test="activityId != null">#{activityId},</if>
            <if test="checkinTime != null">#{checkinTime},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateActivitiesCheckin" parameterType="ActivitiesCheckin">
        update ofa_activities_checkin
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="checkinTime != null">checkin_time = #{checkinTime},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where checkin_id = #{checkinId}
    </update>

    <delete id="deleteActivitiesCheckinByCheckinId" parameterType="Long">
        delete from ofa_activities_checkin where checkin_id = #{checkinId}
    </delete>

    <delete id="deleteActivitiesCheckinByCheckinIds" parameterType="String">
        delete from ofa_activities_checkin where checkin_id in
        <foreach item="checkinId" collection="array" open="(" separator="," close=")">
            #{checkinId}
        </foreach>
    </delete>
</mapper>