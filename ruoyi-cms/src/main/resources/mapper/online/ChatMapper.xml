<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.online.mapper.ChatMapper">
    
    <resultMap type="ChatGroupVo" id="ChatGroupResult">
        <result property="groupId"    column="group_id"    />
        <result property="orderNum"    column="order_num"    />
        <result property="groupName"    column="group_name"    />
        <result property="pic"    column="pic"    />
        <result property="status"    column="status"    />
        <result property="appored"    column="appored"    />
        <result property="joinGroupState"    column="join_group_state"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="apporBy"    column="appor_by"    />
        <result property="apporTime"    column="appor_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectChatGroupVo">
        select group_id, order_num, group_name, pic, status,appored,'0' join_group_state, del_flag, create_by, create_time, update_by, update_time,
               appor_by, appor_time,remark from chat_group
    </sql>

    <select id="selectChatGroupList" parameterType="ChatGroup" resultMap="ChatGroupResult">
        <include refid="selectChatGroupVo"/>
        <where>  
            <if test="groupName != null  and groupName != ''"> and group_name like concat('%', #{groupName}, '%')</if>
            and status='0'
            and appored='2'
            and del_flag='0'
        </where>
    </select>
    
    <select id="selectChatGroupByGroupId" parameterType="ChatGroupMenbers" resultMap="ChatGroupResult">
        <include refid="selectChatGroupVo"/>
        where group_id = #{groupId}
    </select>


</mapper>