<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.job.mapper.ResSkillMapper">

    <resultMap type="ResSkill" id="ResSkillResult">
        <result property="skillid"    column="skillid"    />
        <result property="orderNum"    column="order_num"    />
        <result property="title"    column="title"    />
        <result property="pic"    column="pic"    />
        <result property="skillType"    column="skill_type"    />
        <result property="content"    column="content"    />
        <result property="status"    column="status"    />
        <result property="appored"    column="appored"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="userId"    column="user_id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="apporBy"    column="appor_by"    />
        <result property="apporTime"    column="appor_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectResSkillVo">
        select skillid, order_num, title, pic, skill_type, content, status, appored,publish_time,
               create_by, create_time, update_by, update_time, appor_by,
               appor_time, remark from res_skill  t
    </sql>

    <select id="selectResSkillList" parameterType="ResSkill" resultMap="ResSkillResult">
        <include refid="selectResSkillVo"/>
        <where>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="appored != null  and appored != ''"> and appored = #{appored}</if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
    </select>

    <select id="selectResSkillBySkillid" parameterType="Long" resultMap="ResSkillResult">
        <include refid="selectResSkillVo"/>
        where skillid = #{skillid}
    </select>

    <insert id="insertResSkill" parameterType="ResSkill" useGeneratedKeys="true" keyProperty="skillid">
        insert into res_skill
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">order_num,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="pic != null">pic,</if>
            <if test="skillType != null and skillType != ''">skill_type,</if>
            <if test="content != null">content,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="appored != null and appored != ''">appored,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="apporBy != null">appor_by,</if>
            <if test="apporTime != null">appor_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">#{orderNum},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="pic != null">#{pic},</if>
            <if test="skillType != null and skillType != ''">#{skillType},</if>
            <if test="content != null">#{content},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="appored != null and appored != ''">#{appored},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="apporBy != null">#{apporBy},</if>
            <if test="apporTime != null">#{apporTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateResSkill" parameterType="ResSkill">
        update res_skill
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="pic != null">pic = #{pic},</if>
            <if test="skillType != null and skillType != ''">skill_type = #{skillType},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="appored != null and appored != ''">appored = #{appored},</if>
            <if test="publishTime != null">publish_time=#{publishTime},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where skillid = #{skillid}
    </update>

    <delete id="deleteResSkillBySkillid" parameterType="Long">
        delete from res_skill where skillid = #{skillid}
    </delete>

    <delete id="deleteResSkillBySkillids" parameterType="String">
        delete from res_skill where skillid in
        <foreach item="skillid" collection="array" open="(" separator="," close=")">
            #{skillid}
        </foreach>
    </delete>

    <select id="selectApporedByIds" parameterType="String" resultType="java.lang.Integer">
        select skillid from res_skill where appored in ('1','2') and skillid in
        <foreach item="skillid" collection="array" open="(" separator="," close=")">
            #{skillid}
        </foreach>
    </select>

    <update id="updateStatus" parameterType="ResSkill">
        update res_skill
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where skillid = #{skillid}
    </update>

    <update id="apporByIds"  parameterType="ResApporParam">
        update res_skill
        <trim prefix="SET" suffixOverrides=",">
            <if test="flag != null">appored = #{flag},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="apporTime != null">publish_time = #{publishTime}</if>
            where skillid in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

    <update id="unApporById" parameterType="Long">
        update res_skill
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time = NULL,
        </trim>
        where skillid = #{Id}
    </update>

    <update id="unApporByIds" parameterType="String">
        update res_skill
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time=NULL
            where skillid in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

</mapper>