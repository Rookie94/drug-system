<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.res.mapper.ResArticlesMapper">

    <resultMap type="ResArticlesVo" id="ResArticlesResult">
        <result property="articleId"    column="article_id"    />
        <result property="orderNum"    column="order_num"    />
        <result property="title"    column="title"    />
        <result property="categoryId"    column="category_id"    />
        <result property="typeId"    column="type_id"    />
        <result property="categoryName"    column="category_name"    />
        <result property="typeName"    column="type_name"    />
        <result property="content"    column="content"    />
        <result property="views"    column="views"    />
        <result property="status"    column="status"    />
        <result property="appored"    column="appored"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="pic"    column="pic"    />
        <result property="userId"    column="user_id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="apporBy"    column="appor_by"    />
        <result property="apporTime"    column="appor_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <resultMap type="ResCategoryInfo" id="ResCategoryInfoResult">
        <result property="categoryId"    column="category_id"    />
        <result property="categoryName"    column="category_name"    />
    </resultMap>

    <sql id="selectResArticlesVo">
        select t.article_id, t.order_num, t.title, t.category_id,c.category_name, t.type_id,s.category_name type_name,
         content, views, t.status, appored,publish_time, pic,t.create_by, t.create_time, t.update_by, t.update_time, t.appor_by,
         t.appor_time, t.remark
        from res_articles t
        left join res_category c on t.category_id=c.id
        left join res_category s on t.type_id=s.id
    </sql>

    <select id="selectCategoryList" resultMap="ResCategoryInfoResult">
        select id,category_name from res_category where
        parent_id in (select id from res_category where category_name='戒治资源' ) order by sort_order
    </select>

    <select id="selectSubCategoryList"  parameterType="Long" resultMap="ResCategoryInfoResult">
        select id,category_name from res_category where parent_id=#{categoryId} order by sort_order
    </select>

    <select id="selectResArticlesList" parameterType="ResArticles" resultMap="ResArticlesResult">
        <include refid="selectResArticlesVo"/>
        <where>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="typeId != null "> and type_id = #{typeId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="appored != null  and appored != ''"> and appored = #{appored}</if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
    </select>

    <select id="selectResArticlesByArticleId" parameterType="Long" resultMap="ResArticlesResult">
        <include refid="selectResArticlesVo"/>
        where article_id = #{articleId}
    </select>

    <insert id="insertResArticles" parameterType="ResArticles" useGeneratedKeys="true" keyProperty="articleId">
        insert into res_articles
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">order_num,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="typeId != null">type_id,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="views != null">views,</if>
            <if test="status != null">status,</if>
            <if test="appored != null">appored,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="pic != null">pic,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="apporBy != null">appor_by,</if>
            <if test="apporTime != null">appor_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">#{orderNum},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="typeId != null">#{typeId},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="views != null">#{views},</if>
            <if test="status != null">#{status},</if>
            <if test="appored != null">#{appored},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="pic != null">#{pic},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="apporBy != null">#{apporBy},</if>
            <if test="apporTime != null">#{apporTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateResArticles" parameterType="ResArticles">
        update res_articles
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="typeId != null">type_id = #{typeId},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="views != null">views = #{views},</if>
            <if test="status != null">status = #{status},</if>
            <if test="appored != null">appored = #{appored},</if>
            <if test="publishTime != null">publish_time=#{publishTime},</if>
            <if test="pic != null">pic = #{pic},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where article_id = #{articleId}
    </update>

    <delete id="deleteResArticlesByArticleId" parameterType="Long">
        delete from res_articles where article_id = #{articleId}
    </delete>

    <delete id="deleteResArticlesByArticleIds" parameterType="String">
        delete from res_articles where article_id in
        <foreach item="articleId" collection="array" open="(" separator="," close=")">
            #{articleId}
        </foreach>
    </delete>

    <select id="selectApporedByIds" parameterType="String" resultType="java.lang.Integer">
        select article_id from res_articles where appored in ('1','2') and article_id in
        <foreach item="articleId" collection="array" open="(" separator="," close=")">
            #{articleId}
        </foreach>
    </select>

    <update id="updateStatus" parameterType="ResArticles">
        update res_articles
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime}</if>
        </trim>
        where article_id = #{articleId}
    </update>

    <update id="apporByIds"  parameterType="ResApporParam">
        update res_articles
        <trim prefix="SET" suffixOverrides=",">
            <if test="flag != null">appored = #{flag},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="apporTime != null">publish_time = #{publishTime}</if>
            where article_id in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

    <update id="unApporById" parameterType="Long">
        update res_articles
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time = NULL
        </trim>
        where article_id = #{Id}
    </update>

    <update id="unApporByIds" parameterType="String">
        update res_articles
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time=NULL
            where article_id in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

</mapper>