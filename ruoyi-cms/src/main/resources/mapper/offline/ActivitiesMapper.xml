    <delete id="deleteActivitiesByActivityId" parameterType="Long">
        delete from ofa_activities where activity_id = #{activityId}
    </delete>

    <delete id="deleteActivitiesByActivityIds" parameterType="String">
        delete from ofa_activities where activity_id in
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
            #{activityId}
        </foreach>
    </delete>


    <select id="selectApporedByIds" parameterType="String" resultType="java.lang.Integer">
        select activity_id from ofa_activities where appored&lt;&gt;'0' and activity_id in
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
            #{activityId}
        </foreach>
    </select>

    <update id="updateStatus" parameterType="Activities">
        update ofa_activities
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where activity_id = #{activityId}
    </update>

    <update id="apporByIds"  parameterType="ResApporParam">
        update ofa_activities
        <trim prefix="SET" suffixOverrides=",">
            <if test="flag != null">appored = #{flag},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="apporTime != null">publish_time = #{publishTime}</if>
            where activity_id in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
            or parent_activity_id in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

    <update id="unApporById" parameterType="Long">
        update ofa_activities
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time = NULL,
        </trim>
        where activity_id = #{Id} or parent_activity_id= #{Id}
    </update>

    <update id="unApporByIds" parameterType="String">
        update ofa_activities
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time=NULL
            where activity_id in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
            </foreach>
            or parent_activity_id in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
