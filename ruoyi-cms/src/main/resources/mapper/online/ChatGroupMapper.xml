<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.online.mapper.ChatGroupMapper">
    
    <resultMap type="ChatGroup" id="ChatGroupResult">
        <result property="groupId"    column="group_id"    />
        <result property="orderNum"    column="order_num"    />
        <result property="groupName"    column="group_name"    />
        <result property="pic"    column="pic"    />
        <result property="status"    column="status"    />
        <result property="appored"    column="appored"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="apporBy"    column="appor_by"    />
        <result property="apporTime"    column="appor_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectChatGroupVo">
        select group_id, order_num, group_name, pic, status,appored, del_flag, create_by, create_time, update_by, update_time,
               appor_by, appor_time,remark from chat_group
    </sql>

    <select id="selectChatGroupList" parameterType="ChatGroup" resultMap="ChatGroupResult">
        <include refid="selectChatGroupVo"/>
        <where>  
            <if test="groupName != null  and groupName != ''"> and group_name like concat('%', #{groupName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectChatGroupByGroupId" parameterType="Long" resultMap="ChatGroupResult">
        <include refid="selectChatGroupVo"/>
        where group_id = #{groupId}
    </select>
        
    <insert id="insertChatGroup" parameterType="ChatGroup" useGeneratedKeys="true" keyProperty="groupId">
        insert into chat_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">order_num,</if>
            <if test="groupName != null">group_name,</if>
            <if test="pic != null">pic,</if>
            <if test="status != null">status,</if>
            <if test="appored != null">appored,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="apporBy != null">appor_by,</if>
            <if test="apporTime != null">appor_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">#{orderNum},</if>
            <if test="groupName != null">#{groupName},</if>
            <if test="pic != null">#{pic},</if>
            <if test="status != null">#{status},</if>
            <if test="appored != null">#{appored},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="apporBy != null">#{apporBy},</if>
            <if test="apporTime != null">#{apporTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateChatGroup" parameterType="ChatGroup">
        update chat_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="groupName != null">group_name = #{groupName},</if>
            <if test="pic != null">pic = #{pic},</if>
            <if test="status != null">status = #{status},</if>
            <if test="appored != null">appored = #{appored},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where group_id = #{groupId}
    </update>

    <delete id="deleteChatGroupByGroupId" parameterType="Long">
        delete from chat_group where group_id = #{groupId}
    </delete>

    <delete id="deleteChatGroupByGroupIds" parameterType="String">
        delete from chat_group where group_id in 
        <foreach item="groupId" collection="array" open="(" separator="," close=")">
            #{groupId}
        </foreach>
    </delete>

    <select id="selectApporedByIds" parameterType="String" resultType="java.lang.Integer">
        select group_id from chat_group where appored='2' and group_id in
        <foreach item="groupId" collection="array" open="(" separator="," close=")">
            #{groupId}
        </foreach>
    </select>

    <update id="updateStatus" parameterType="ChatGroup">
        update chat_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where group_id = #{groupId}
    </update>

    <update id="apporByIds"  parameterType="ResApporParam">
        update chat_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="flag != null">appored = #{flag},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime}</if>
            where group_id in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

    <update id="unApporById" parameterType="Long">
        update chat_group
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            appor_by=NULL,
            appor_time = NULL
        </trim>
        where group_id = #{Id}
    </update>

    <update id="unApporByIds" parameterType="String">
        update chat_group
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            appor_by=NULL,
            appor_time=NULL
            where group_id in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

</mapper>