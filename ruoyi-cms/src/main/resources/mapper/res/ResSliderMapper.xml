<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.res.mapper.ResSliderMapper">
    
    <resultMap type="ResSlider" id="ResSliderResult">
        <result property="sliderId"    column="slider_id"    />
        <result property="orderNum"    column="order_num"    />
        <result property="pic"    column="pic"    />
        <result property="sliderType"    column="slider_type"    />
        <result property="status"    column="status"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="appored"    column="appored"    />
        <result property="userId"    column="user_id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="apporBy"    column="appor_by"    />
        <result property="apporTime"    column="appor_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectResSliderVo">
        select slider_id, order_num, pic, slider_type, status, publish_time, appored, user_id, dept_id, create_by, create_time, update_by, update_time, appor_by, appor_time, remark from res_slider t
    </sql>

    <select id="selectResSliderList" parameterType="ResSlider" resultMap="ResSliderResult">
        <include refid="selectResSliderVo"/>
        <where>  
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
            <if test="pic != null  and pic != ''"> and pic = #{pic}</if>
            <if test="sliderType != null  and sliderType != ''"> and slider_type = #{sliderType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="params.beginPublishTime != null and params.beginPublishTime != '' and params.endPublishTime != null and params.endPublishTime != ''"> and publish_time between #{params.beginPublishTime} and #{params.endPublishTime}</if>
            <if test="appored != null  and appored != ''"> and appored = #{appored}</if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
        order by t.order_num
    </select>
    
    <select id="selectResSliderBySliderId" parameterType="Long" resultMap="ResSliderResult">
        <include refid="selectResSliderVo"/>
        where slider_id = #{sliderId}
    </select>

    <insert id="insertResSlider" parameterType="ResSlider" useGeneratedKeys="true" keyProperty="sliderId">
        insert into res_slider
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">order_num,</if>
            <if test="pic != null">pic,</if>
            <if test="sliderType != null">slider_type,</if>
            <if test="status != null">status,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="appored != null">appored,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="apporBy != null">appor_by,</if>
            <if test="apporTime != null">appor_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNum != null">#{orderNum},</if>
            <if test="pic != null">#{pic},</if>
            <if test="sliderType != null">#{sliderType},</if>
            <if test="status != null">#{status},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="appored != null">#{appored},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="apporBy != null">#{apporBy},</if>
            <if test="apporTime != null">#{apporTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateResSlider" parameterType="ResSlider">
        update res_slider
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="pic != null">pic = #{pic},</if>
            <if test="sliderType != null">slider_type = #{sliderType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="appored != null">appored = #{appored},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where slider_id = #{sliderId}
    </update>

    <delete id="deleteResSliderBySliderId" parameterType="Long">
        delete from res_slider where slider_id = #{sliderId}
    </delete>

    <delete id="deleteResSliderBySliderIds" parameterType="String">
        delete from res_slider where slider_id in 
        <foreach item="sliderId" collection="array" open="(" separator="," close=")">
            #{sliderId}
        </foreach>
    </delete>

    <select id="selectApporedByIds" parameterType="String" resultType="java.lang.Integer">
        select slider_id from res_slider where appored in ('1','2') and slider_id in
        <foreach item="sliderId" collection="array" open="(" separator="," close=")">
            #{sliderId}
        </foreach>
    </select>

    <update id="updateStatus" parameterType="ResSlider">
        update res_slider
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where slider_id = #{sliderId}
    </update>

    <update id="apporByIds"  parameterType="ResApporParam">
        update res_slider
        <trim prefix="SET" suffixOverrides=",">
            <if test="flag != null">appored = #{flag},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="publishTime != null">publish_time = #{publishTime}</if>
            where slider_id in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

    <update id="unApporById" parameterType="Long">
        update res_slider
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time = NULL,
        </trim>
        where slider_id = #{sliderId}
    </update>

    <update id="unApporByIds" parameterType="String">
        update res_slider
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time=NULL
            where slider_id in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

</mapper>