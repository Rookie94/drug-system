<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.scale.mapper.LbsResultsMapper">

    <resultMap type="LbsResultsVo" id="LbsResultsResult">
        <result property="resultId"    column="result_id"    />
        <result property="resultNo"    column="result_no"    />
        <result property="contextId"    column="context_id"    />
        <result property="contextNo"    column="context_no"    />
        <result property="contextName"    column="context_name"    />
        <result property="deptId"    column="dept_id"    />
        <result property="deptName"    column="dept_name"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="nickName"    column="nick_name"    />
        <result property="userType"    column="user_type"    />
        <result property="sex"    column="sex"    />
        <result property="birthday"    column="birthday"    />
        <result property="phonenumber"    column="phonenumber"    />
        <result property="commitTime"    column="commit_time"    />
        <result property="jsonResult"    column="json_result"    />
        <result property="thinJsonResult"    column="thin_json_result"    />
        <result property="jsonReport"    column="json_report"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectLbsResultsVo">
        SELECT
            t.result_id,
            t.result_no,
            t.context_id,
            c.context_no,
            c.context_name,
            t.dept_id,
            d.dept_name,
            t.user_id,
            u.user_name,
            u.nick_name,
            u.user_type,
            u.sex,
            u.birthday,
            u.phonenumber,
            t.commit_time,
            t.json_result,
            t.thin_json_result,
            t.json_report,
            t.create_by,
            t.create_time,
            t.update_by,
            t.update_time,
            t.remark
        FROM
            lbs_results AS t
                LEFT JOIN lbs_contexts AS c ON t.context_id = c.context_id
                LEFT JOIN sys_dept AS d ON t.dept_id = d.dept_id
                LEFT JOIN sys_user AS u ON t.user_id = u.user_id
    </sql>

    <select id="selectLbsResultsList" parameterType="LbsResultsVo" resultMap="LbsResultsResult">
        <include refid="selectLbsResultsVo"/>
        <where>
            <if test="resultNo != null "> and t.result_no = #{resultNo}</if>
            <if test="contextId != null "> and t.context_id = #{contextId}</if>
            <if test="contextNo != null  and contextNo != ''"> and context_no like concat('%', #{contextNo}, '%')</if>
            <if test="contextName != null  and contextName != ''"> and context_name like concat('%', #{contextName}, '%')</if>
            <if test="deptName != null  and deptName != ''"> and dept_name like concat('%', #{deptName}, '%')</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="nickName != null  and nickName != ''"> and nick_name like concat('%', #{nickName}, '%')</if>
            <if test="sex != null  and sex != ''"> and sex = #{sex}</if>
            <if test="birthday != null "> and birthday = #{birthday}</if>
            <if test="phonenumber != null  and phonenumber != ''"> and phonenumber like concat('%', #{phonenumber}, '%')</if>
            <if test="params.beginCommitTime != null and params.beginCommitTime != '' and params.endCommitTime != null and params.endCommitTime != ''"> and t.commit_time between #{params.beginCommitTime} and #{params.endCommitTime}</if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
    </select>

    <select id="selectLbsResultsByResultId" parameterType="Long" resultMap="LbsResultsResult">
        <include refid="selectLbsResultsVo"/>
        where result_id = #{resultId}
    </select>

    <insert id="insertLbsResults" parameterType="LbsResults">
        insert into lbs_results
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="resultId != null">result_id,</if>
            <if test="resultNo != null">result_no,</if>
            <if test="contextId != null">context_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="commitTime != null">commit_time,</if>
            <if test="jsonResult != null">json_result,</if>
            <if test="thinJsonResult != null">thin_json_result,</if>
            <if test="jsonReport != null">json_report,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="resultId != null">#{resultId},</if>
            <if test="resultNo != null">#{resultNo},</if>
            <if test="contextId != null">#{contextId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="commitTime != null">#{commitTime},</if>
            <if test="jsonResult != null">#{jsonResult},</if>
            <if test="thinJsonResult != null">#{thinJsonResult},</if>
            <if test="jsonReport != null">#{jsonReport},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateLbsResults" parameterType="LbsResults">
        update lbs_results
        <trim prefix="SET" suffixOverrides=",">
            <if test="resultNo != null">result_no = #{resultNo},</if>
            <if test="contextId != null">context_id = #{contextId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="commitTime != null">commit_time = #{commitTime},</if>
            <if test="jsonResult != null">json_result = #{jsonResult},</if>
            <if test="thinJsonResult != null">thin_json_result = #{thinJsonResult},</if>
            <if test="jsonReport != null">json_report = #{jsonReport},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where result_id = #{resultId}
    </update>

    <delete id="deleteLbsResultsByResultId" parameterType="Long">
        delete from lbs_results where result_id = #{resultId}
    </delete>

    <delete id="deleteLbsResultsByResultIds" parameterType="String">
        delete from lbs_results where result_id in
        <foreach item="resultId" collection="array" open="(" separator="," close=")">
            #{resultId}
        </foreach>
    </delete>
</mapper>