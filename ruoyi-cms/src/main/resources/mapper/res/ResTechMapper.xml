<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.res.mapper.ResTechMapper">
    
    <resultMap type="ResTech" id="ResTechResult">
        <result property="techId"    column="tech_id"    />
        <result property="orderNum"    column="order_num"    />
        <result property="title"    column="title"    />
        <result property="pic"    column="pic"    />
        <result property="techType"    column="tech_type"    />
        <result property="content"    column="content"    />
        <result property="status"    column="status"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="appored"    column="appored"    />
        <result property="userId"    column="user_id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="apporBy"    column="appor_by"    />
        <result property="apporTime"    column="appor_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectResTechVo">
        select tech_id, order_num, title, pic, tech_type, content, status, publish_time, appored, user_id, dept_id, create_by, create_time, update_by, update_time, appor_by, appor_time, remark from res_tech t
    </sql>

    <select id="selectResTechList" parameterType="ResTech" resultMap="ResTechResult">
        <include refid="selectResTechVo"/>
        <where>
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="techType != null  and techType != ''"> and tech_type = #{techType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="params.beginPublishTime != null and params.beginPublishTime != '' and params.endPublishTime != null and params.endPublishTime != ''"> and publish_time between #{params.beginPublishTime} and #{params.endPublishTime}</if>
            <if test="appored != null  and appored != ''"> and appored = #{appored}</if>
            <if test="apporBy != null  and apporBy != ''"> and appor_by = #{apporBy}</if>
            <if test="apporTime != null "> and appor_time = #{apporTime}</if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
        order by order_num
    </select>
    
    <select id="selectResTechByTechId" parameterType="Long" resultMap="ResTechResult">
        <include refid="selectResTechVo"/>
        where tech_id = #{techId}
    </select>

    <insert id="insertResTech" parameterType="ResTech">
        insert into res_tech
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="techId != null">tech_id,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="title != null">title,</if>
            <if test="pic != null">pic,</if>
            <if test="techType != null">tech_type,</if>
            <if test="content != null">content,</if>
            <if test="status != null">status,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="appored != null">appored,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="apporBy != null">appor_by,</if>
            <if test="apporTime != null">appor_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="techId != null">#{techId},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="title != null">#{title},</if>
            <if test="pic != null">#{pic},</if>
            <if test="techType != null">#{techType},</if>
            <if test="content != null">#{content},</if>
            <if test="status != null">#{status},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="appored != null">#{appored},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="apporBy != null">#{apporBy},</if>
            <if test="apporTime != null">#{apporTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateResTech" parameterType="ResTech">
        update res_tech
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="title != null">title = #{title},</if>
            <if test="pic != null">pic = #{pic},</if>
            <if test="techType != null">tech_type = #{techType},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null">status = #{status},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="appored != null">appored = #{appored},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where tech_id = #{techId}
    </update>

    <delete id="deleteResTechByTechId" parameterType="Long">
        delete from res_tech where tech_id = #{techId}
    </delete>

    <delete id="deleteResTechByTechIds" parameterType="String">
        delete from res_tech where tech_id in 
        <foreach item="techId" collection="array" open="(" separator="," close=")">
            #{techId}
        </foreach>
    </delete>

    <select id="selectApporedByIds" parameterType="String" resultType="java.lang.Integer">
        select tech_id from res_tech where appored in ('1','2') and tech_id in
        <foreach item="techId" collection="array" open="(" separator="," close=")">
            #{techId}
        </foreach>
    </select>

    <update id="updateStatus" parameterType="ResTech">
        update res_tech
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where tech_id = #{techId}
    </update>

    <update id="apporByIds"  parameterType="ResApporParam">
        update res_tech
        <trim prefix="SET" suffixOverrides=",">
            <if test="flag != null">appored = #{flag},</if>
            <if test="apporBy != null">appor_by = #{apporBy},</if>
            <if test="apporTime != null">appor_time = #{apporTime},</if>
            <if test="publishTime != null">publish_time = #{publishTime}</if>
            where tech_id in
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

    <update id="unApporById" parameterType="Long">
        update res_tech
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time = NULL,
        </trim>
        where tech_id = #{techId}
    </update>

    <update id="unApporByIds" parameterType="String">
        update res_tech
        <trim prefix="SET" suffixOverrides=",">
            appored='0',
            publish_time=NULL,
            appor_by=NULL,
            appor_time=NULL
            where tech_id in
            <foreach item="id" collection="array" open="(" separator="," close=")">
                #{id}
            </foreach>
        </trim>
    </update>

</mapper>