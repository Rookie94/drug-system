<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SerialNoMapper">

    <resultMap type="SerialNo" id="SerialNoResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="prefix"    column="prefix"    />
        <result property="suffix"    column="suffix"    />
        <result property="dateFormat"    column="date_format"    />
        <result property="seqLength"    column="seq_length"    />
        <result property="currentSeq"    column="current_seq"    />
        <result property="resetStrategy"    column="reset_strategy"    />
        <result property="lastResetDate"    column="last_reset_date"    />
        <result property="version"    column="version"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSerialNoVo">
        select id, name, prefix, suffix, date_format, seq_length, current_seq, reset_strategy, last_reset_date, version, status, create_by, create_time, update_by, update_time, remark from sys_serialno
    </sql>

    <select id="selectSerialNoList" parameterType="SerialNo" resultMap="SerialNoResult">
        <include refid="selectSerialNoVo"/>
        <where>
            <if test="id != null  and id != ''"> and id = #{id}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="prefix != null  and prefix != ''"> and prefix like concat('%', #{prefix}, '%')</if>
            <if test="suffix != null  and suffix != ''"> and suffix like concat('%', #{suffix}, '%')</if>
            <if test="dateFormat != null  and dateFormat != ''"> and date_format like concat('%', #{dateFormat}, '%')</if>
            <if test="seqLength != null "> and seq_length = #{seqLength}</if>
            <if test="currentSeq != null "> and current_seq = #{currentSeq}</if>
            <if test="resetStrategy != null  and resetStrategy != ''"> and reset_strategy = #{resetStrategy}</if>
            <if test="lastResetDate != null  and lastResetDate != ''"> and last_reset_date = #{lastResetDate}</if>
            <if test="version != null "> and version = #{version}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectSerialNoById" parameterType="String" resultMap="SerialNoResult">
        <include refid="selectSerialNoVo"/>
        where id = #{id}
    </select>

    <insert id="insertSerialNo" parameterType="SerialNo">
        insert into sys_serialno
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="prefix != null">prefix,</if>
            <if test="suffix != null">suffix,</if>
            <if test="dateFormat != null and dateFormat != ''">date_format,</if>
            <if test="seqLength != null">seq_length,</if>
            <if test="currentSeq != null">current_seq,</if>
            <if test="resetStrategy != null">reset_strategy,</if>
            <if test="lastResetDate != null">last_reset_date,</if>
            <if test="version != null">version,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="prefix != null">#{prefix},</if>
            <if test="suffix != null">#{suffix},</if>
            <if test="dateFormat != null and dateFormat != ''">#{dateFormat},</if>
            <if test="seqLength != null">#{seqLength},</if>
            <if test="currentSeq != null">#{currentSeq},</if>
            <if test="resetStrategy != null">#{resetStrategy},</if>
            <if test="lastResetDate != null">#{lastResetDate},</if>
            <if test="version != null">#{version},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSerialNo" parameterType="SerialNo">
        update sys_serialno
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="prefix != null">prefix = #{prefix},</if>
            <if test="suffix != null">suffix = #{suffix},</if>
            <if test="dateFormat != null and dateFormat != ''">date_format = #{dateFormat},</if>
            <if test="seqLength != null">seq_length = #{seqLength},</if>
            <if test="currentSeq != null">current_seq = #{currentSeq},</if>
            <if test="resetStrategy != null">reset_strategy = #{resetStrategy},</if>
            <if test="lastResetDate != null">last_reset_date = #{lastResetDate},</if>
            <if test="version != null">version = #{version},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <!-- 带版本控制的更新 -->
    <update id="updateSerialNoWithVersion" parameterType="SerialNo">
        update sys_serialno
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="prefix != null">prefix = #{prefix},</if>
            <if test="suffix != null">suffix = #{suffix},</if>
            <if test="dateFormat != null and dateFormat != ''">date_format = #{dateFormat},</if>
            <if test="seqLength != null">seq_length = #{seqLength},</if>
            <if test="currentSeq != null">current_seq = #{currentSeq},</if>
            <if test="resetStrategy != null">reset_strategy = #{resetStrategy},</if>
            <if test="lastResetDate != null">last_reset_date = #{lastResetDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            version = version + 1
        </trim>
        where id = #{id} and version = #{version}
    </update>

    <delete id="deleteSerialNoById" parameterType="String">
        delete from sys_serialno where id = #{id}
    </delete>

    <delete id="deleteSerialNoByIds" parameterType="String">
        delete from sys_serialno where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>