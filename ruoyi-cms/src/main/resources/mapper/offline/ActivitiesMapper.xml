    <sql id="selectActivitiesVo">
        select activity_id, parent_activity_id, order_num, activity_name, img, address, org_name, content, tel,
               start_time, end_time,activity_type, status, appored,publish_time, del_flag, user_id, dept_id, create_by, create_time,
               update_by, update_time, remark, appor_by, appor_time from ofa_activities t
    </sql>

    <sql id="filterConditions">
        <if test="parentActivityId != null ">and parent_activity_id = #{parentActivityId}</if>
        <if test="activityName != null and activityName != ''">and activity_name like CONCAT('%', #{activityName}, '%')</if>
        <if test="orgName != null and orgName != ''">and org_name like CONCAT('%', #{orgName}, '%')</if>
        <if test="startTime != null">and start_time &gt;= #{startTime}</if>
        <if test="endTime != null">and end_time &lt;= #{endTime}</if>
        <if test="status != null and status != ''">and status = #{status}</if>
        <if test="appored != null and appored != ''">and appored = #{appored}</if>
        <!-- 数据范围过滤 -->
        ${params.dataScope}
    </sql>

    <select id="selectActivitiesList" parameterType="Activities" resultMap="ActivitiesResult">
        <include refid="selectActivitiesVo"/>
        <where>
            <include refid="filterConditions"/>
        </where>
    </select>

    <select id="selectPrimaryActivitiesList" parameterType="Activities" resultMap="ActivitiesResult">
        <include refid="selectActivitiesVo"/>
        <where>
            <if test="parentActivityId != null ">and parent_activity_id = #{parentActivityId}</if>
            <if test="activityName != null and activityName != ''">and activity_name like CONCAT('%', #{activityName}, '%')</if>
            <if test="orgName != null and orgName != ''">and org_name like CONCAT('%', #{orgName}, '%')</if>
            <if test="startTime != null">and start_time &gt;= #{startTime}</if>
            <if test="endTime != null">and end_time &lt;= #{endTime}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            and appored in ('2','3')
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
    </select>

    <select id="selectActivitiesWithChild" parameterType="Activities" resultMap="ActivitiesResult">
        select distinct t.* from
        (
            <include refid="selectActivitiesVo"/>
            <where>
                parent_activity_id = 0
                <include refid="filterConditions"/>
            </where>
            union all
            <include refid="selectActivitiesVo"/> where parent_activity_id in
            (
                select activity_id from ofa_activities
                <where>
                    parent_activity_id = 0
                    <include refid="filterConditions"/>
                </where>
            )
            union all
            <include refid="selectActivitiesVo"/> where activity_id in
            (
                select parent_activity_id from ofa_activities
                <where>
                    parent_activity_id &lt;&gt;'0'
                    <include refid="filterConditions"/>
                </where>
            )
            union all
            <include refid="selectActivitiesVo"/> where parent_activity_id in
            (
            select parent_activity_id from ofa_activities
            <where>
                parent_activity_id &lt;&gt;'0'
                <include refid="filterConditions"/>
            </where>
            )
        ) t
    </select>

    <select id="selectActivitiesByActivityId" parameterType="Long" resultMap="ActivitiesResult">
        <include refid="selectActivitiesVo"/>
        where activity_id = #{activityId}
    </select>


    <select id="selectActivitiesStateByStudent" parameterType="ActivitiesStateVo" resultMap="ActivitiesStateResult">
        SELECT * FROM
            (
                SELECT
                    a.*,
                    s.dict_label hd_state,
                    CASE WHEN b.user_id IS NULL THEN 0 ELSE 1 END is_signed,
                    CASE WHEN (a.appored in ('2','3') and b.user_id is null) THEN 1 ELSE 0 END can_sign,
                    CASE WHEN c.user_id IS NULL THEN 0 ELSE 1 END is_checkin,
                    CASE WHEN (a.appored ='3' and c.user_id is null) THEN 1 ELSE 0 END can_checkin,
                    CASE WHEN d.user_id IS NULL THEN 0 ELSE 1 END is_review,
                    CASE WHEN (a.appored in ('3','4') and d.user_id is null) THEN 1 ELSE 0 END can_review
                FROM
                    ofa_activities a
                        left join
                    (
                        select b.dict_label,b.dict_value from sys_dict_type a inner join sys_dict_data b on a.dict_type=b.dict_type
                        where a.dict_type='sys_activities_status' and a.status='0' and b.status='0'
                    ) s on a.appored=s.dict_value
                        LEFT JOIN ( SELECT activity_id,user_id FROM ofa_activities_signup WHERE user_id = #{userId} ) b ON a.activity_id = b.activity_id
                        LEFT JOIN ( SELECT activity_id,user_id FROM ofa_activities_checkin WHERE user_id = #{userId} ) c ON a.activity_id = c.activity_id
                        LEFT JOIN ( SELECT activity_id,user_id FROM ofa_activities_review WHERE user_id = #{userId} ) d ON a.activity_id = d.activity_id
                WHERE
                    a.parent_activity_id = 0
                  AND a.appored IN ('2','3','4')
            ) X
            <where>
                <if test="activityId != null ">and activity_id = #{activityId}</if>
                <if test="activityName != null and activityName != ''">and activity_name like CONCAT('%', #{activityName}, '%')</if>
                <if test="orgName != null and orgName != ''">and org_name like CONCAT('%', #{orgName}, '%')</if>
                <if test="startTime != null">and start_time &gt;= #{startTime}</if>
                <if test="endTime != null">and end_time &lt;= #{endTime}</if>
                <if test="status != null and status != ''">and status = #{status}</if>
                <if test="appored != null and appored != ''">and appored = #{appored}</if>
                <if test="hdState != null and hdStatus != ''">and hd_state = #{hdState}</if>
                <if test="isSigned != null and isSigned != ''">and is_signed = #{isSigned}</if>
                <if test="canSign != null and canSign != ''">and can_sign = #{canSign}</if>
                <if test="isCheckIn != null and isCheckIn != ''">and is_checkin = #{isCheckIn}</if>
                <if test="canCheckIn != null and canCheckIn != ''">and can_checkin = #{canCheckIn}</if>
                <if test="isReview != null and isReview != ''">and is_review = #{isReview}</if>
                <if test="canReview != null and canReview != ''">and can_review = #{canReview}</if>
            </where>
    </select>

